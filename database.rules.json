{
  "rules": {
    ".read": false,
    ".write": false,
    "players": {
      ".read": true,
      ".indexOn": ["points"],
      "$id": {
        ".write": "$id.matches(/^[0-9]{5,20}$/)",
        ".validate": "newData.hasChildren(['name', 'points'])",
        "name": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "points": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
        "wins": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "losses": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "kills": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "deaths": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "updated": { ".validate": "newData.isString() && newData.val().length <= 32" },
        "version": { ".validate": "newData.isString() && newData.val().length <= 16" },
        "$other": { ".validate": false }
      }
    }
  }
}
